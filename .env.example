# ==============================================================================
# AGI Data Ingestion & Cloud Persistence Engine Configuration
# ==============================================================================

# Target GCS bucket for object persistence
GCS_BUCKET_NAME=agi-agent-ingestion-data

# Optional path to GCP Service Account JSON key (leave empty to use Application Default Credentials)
# GCS_CREDENTIALS_PATH=./secrets/service-account.json

# Streaming chunk size in bytes (must be multiple of 262144 bytes / 256 KiB; default is 8MB)
GCS_CHUNK_SIZE=8388608

# HTTP Client identification
USER_AGENT=AGI-Agent-Ingestion/1.0 (+https://github.com/Rajuzet/AGI-pack; contact=autonomous-agent@cloud.internal)

# Ingestion stream poll intervals (in seconds)
POLL_INTERVAL_SECONDS=300
HTTP_TIMEOUT_SECONDS=30.0

# ArXiv query parameters
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_CATEGORIES=["cs.AI", "cs.LG", "stat.ML"]
ARXIV_MAX_RESULTS=25

# Content normalization token ceiling
MAX_CONTENT_TOKENS=4000

# Local buffer and staging directory
STAGING_DIR=./data_staging

# Logging verbosity
LOG_LEVEL=INFO

# ==============================================================================
# MySQL Relational Audit Database (MySQL Workbench)
# ==============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agi_memory
MYSQL_POOL_SIZE=5
